mponent-entry/SKILL.md", "source_location": "L100-L102", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "DigiKey lifecycle status Obsolete, Not For New Designs or Last Time Buy must be surfaced before insert, with a prompt for an Alternate_Part_Number."}, {"id": "_claude_skills_brensan_component_entry_skill_utf8_console_flag", "label": "-X utf8 for \u03a9 \u00b5 \u00b0 output", "file_type": "rationale", "source_file": ".claude/skills/brensan-component-entry/SKILL.md", "source_location": "L24-L25", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Records contain \u03a9, \u00b5 and \u00b0; the Windows console code page cannot print them without -X utf8."}], "edges": [{"source": "_claude_skills_brensan_component_entry_skill_brensan_component_entry", "target": "_claude_skills_brensan_component_entry_skill_component_tool", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".claude/skills/brensan-component-entry/SKILL.md", "source_location": null, "weight": 1.0}, {"source": "_claude_skills_brensan_component_entry_skill_brensan_component_entry", "target": "_claude_skills_brensan_component_entry_skill_data_layer_only_writes", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".claude/skills/brensan-component-entry/SKILL.md", "source_location": null, "weight": 1.0}, {"source": "_claude_skills_brensan_component_entry_skill_brensan_component_entry", "target": "_claude_skills_brensan_component_entry_skill_target_database_and_user_agreement", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".claude/skills/brensan-component-entry/SKILL.md", "source_location": null, "weight": 1.0}, {"source": "_claude_skills_brensan_component_entry_skill_brensan_component_entry", "target": "_claude_skills_brensan_component_entry_skill_duplicate_check_first", "relation": "references",