{"nodes": [{"id": "_claude_skills_brensan_component_entry_skill_brensan_component_entry", "label": "Brensan Component Entry Skill", "file_type": "document", "source_file": ".claude/skills/brensan-component-entry/SKILL.md", "source_location": "L1-L103", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "_claude_skills_brensan_component_entry_skill_component_tool", "label": "component_tool.py CLI (users/tables/check/lookup/suggest/add)", "file_type": "concept", "source_file": ".claude/skills/brensan-component-entry/SKILL.md", "source_location": "L17-L25", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "_claude_skills_brensan_component_entry_skill_data_layer_only_writes", "label": "Write only through the application data layer", "file_type": "rationale", "source_file": ".claude/skills/brensan-component-entry/SKILL.md", "source_location": "L8-L15", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Raw SQL inserts skip Created_By, the Change_Log row, the admin-only Verified rule and KiCad value formatting, leaving records the GUI cannot trace; so the skill always goes through the app's db layer via the bundled tool."}, {"id": "_claude_skills_brensan_component_entry_skill_target_database_and_user_agreement", "label": "Agree on target database and acting user first", "file_type": "rationale", "source_file": ".claude/skills/brensan-component-entry/SKILL.md", "source_location": "L29-L35", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Several DB copies exist (Z:\\Muhendislik\\Kicad shared, _Source Code dev copy, stale copies beside the exe); Created_By must name a real active human, so the tool refuses unknown or inactive users and the agent must never guess the DB."}, {"id": "_claude_skills_brensan_component_entry_skill_duplicate_check_first", "label": "Duplicate check before insert", "file_type": "rationale", "sou